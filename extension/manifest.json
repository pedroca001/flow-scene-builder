{
  "manifest_version": 3,
  "name": "Flow Scene Builder",
  "version": "0.3.0",
  "description": "Encadeia cenas a partir de uma imagem no Flow e monta um MP4 localmente.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "debugger",
    "downloads",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://flow-content.google/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Flow Scene Builder"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "key": ""
}
